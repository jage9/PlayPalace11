# Game Roulette messages

game-name-roulette = Game Roulette

# Options
roulette-set-finish-mode = Finish mode: { $mode }
roulette-select-finish-mode = Select finish mode
roulette-option-changed-finish-mode = Finish mode set to { $mode }.
roulette-finish-mode-rounds = Rounds
roulette-finish-mode-score = Score
roulette-desc-finish-mode = Rounds mode awards one point per round win. Score mode adds game points, reverses lower-is-better scores, and awards 100 per win in games without points.

roulette-set-total-rounds = Total rounds: { $rounds }
roulette-enter-total-rounds = Enter total rounds (1-1000):
roulette-option-changed-total-rounds = Total rounds set to { $rounds }.
roulette-desc-total-rounds = Number of roulette rounds before the session ends.

roulette-set-target-score = Target score: { $score }
roulette-enter-target-score = Enter target score (1-100000):
roulette-option-changed-target-score = Target score set to { $score }.
roulette-desc-target-score = Score required to end Game Roulette in score mode.

roulette-set-jokers = Jokers per player: { $jokers }
roulette-enter-jokers = Enter jokers per player (0-10):
roulette-option-changed-jokers = Jokers per player set to { $jokers }.
roulette-desc-jokers = Jokers each player may use during the whole Game Roulette session.

roulette-set-included-games = Included games ({ $count } of { $total } selected)
roulette-option-changed-included-games = Included games updated ({ $count } of { $total } selected).
roulette-desc-included-games = Games enabled for random selection. All games are enabled by default; each round selects only a game that supports the current player count.

# Session status
roulette-standings = Roulette standings
roulette-score = { $player }: { $score }
roulette-finished = Game Roulette is finished.
roulette-next-round = Next random game
roulette-no-compatible-games = None of the included games support the current players. Change the included games or player count.
roulette-round-start = Roulette round { $round }: { $game }
roulette-spinning = The wheel is spinning...
roulette-joker-window = Press J within five seconds to block this game with a joker.
roulette-no-jokers = You have no jokers remaining.
roulette-joker-used = { $player } used a joker. { $remaining } remaining.
roulette-joker-unavailable = Jokers can only be used during the joker window.
roulette-no-alternative = No other compatible, unblocked game is available. Your joker was not used.
roulette-selected-game = Selected game: { $game }
roulette-joker-action = Use a joker ({ $count } remaining)
roulette-all-games = All games
